{
  "name": "raumplaner-studio",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raumplaner",
      "database_id": "local",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "raumplaner-images" }],
  "vars": { "LOCAL_DEV": "true" }
}
